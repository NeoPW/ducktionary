# Copy to .env.local (git-ignored) and fill in. All values here are optional.

# Cloud backup — see supabase/README.md. Both are public by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Books search, restricted to the Books API.
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=

# Only for `npm run supabase:check` — two test accounts, never used by the app.
SECURITY_CHECK_A_EMAIL=
SECURITY_CHECK_A_PASSWORD=
SECURITY_CHECK_B_EMAIL=
SECURITY_CHECK_B_PASSWORD=
